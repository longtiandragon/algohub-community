[Unit]
Description=AlgoHub backend
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
User=algohub
Group=algohub
WorkingDirectory=/opt/algohub
EnvironmentFile=/etc/algohub/production.env
ExecStart=/usr/bin/java -Xms256m -Xmx1024m -Dfile.encoding=UTF-8 -jar /opt/algohub/algohub.jar
Restart=on-failure
RestartSec=10
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc/algohub/secrets
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
