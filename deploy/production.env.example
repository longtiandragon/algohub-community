# 复制为 /etc/algohub/production.env，root 所有，权限 600；不提交真实值。
# 同时用于 systemd EnvironmentFile 和 docker compose --env-file。
DB_PASSWORD=
# 可选：先创建受限角色再填写。不设置时仍使用初始化角色；不要设置空值。
# DB_APP_USERNAME=algohub_app
# DB_APP_PASSWORD=填写受限角色的独立密码
REDIS_PASSWORD=
# 新库必须填写 10–64 位密码；已有管理员不会被覆盖，改密后可留空。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
PUBLIC_ORIGIN=https://algo.example.com
SPRING_PROFILES_ACTIVE=prod,mail
REMINDERS_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 可选：请求外站的限流（每 10 分钟）和每个平台的账号上限，不填用默认值
OUTBOUND_PER_USER=30
OUTBOUND_PER_IP=300
MAX_ACCOUNTS_PER_PLATFORM=3
# 资源预算须与实际并发验证；Redis 留运行/AOF 开销且不淘汰会话键。
POSTGRES_MEMORY_LIMIT=768m
REDIS_MEMORY_LIMIT=256m
REDIS_MAXMEMORY=128mb
# 可选：你的告警接收端；脚本只发送固定故障文本，不发送配置或凭据。
ALERT_WEBHOOK_URL=
